{
  "name": "@formizeflow/react",
  "version": "0.1.0",
  "description": "SSR-safe React components and hooks for FormFlow embeds (inline, popup, modal, drawer, slider, popover).",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/formizeflow/formflow-react.git" },
  "homepage": "https://github.com/formizeflow/formflow-react#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "import": "./dist/index.js", "require": "./dist/index.cjs" } },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.tsx --format esm,cjs --dts --clean --external react",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": { "react": ">=18" },
  "devDependencies": { "@types/node": "^22.10.0", "@types/react": "^19.0.0", "react": "^19.0.0", "tsup": "^8.3.0", "typescript": "^5.7.0" },
  "publishConfig": { "access": "public", "provenance": true }
}
